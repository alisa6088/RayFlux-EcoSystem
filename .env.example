# RayFlux Ecosystem Environment Configuration Template
# Copy to `.env` and customize as needed (or let `core_db/init_postgis_cluster.py` auto-generate it)

RFX_PG_HOST=127.0.0.1
RFX_PG_PORT=5433
RFX_PG_DATABASE=rayflux_spatial_db
RFX_PG_SCHEMA=public
RFX_PG_USER=rayflux_admin
RFX_PG_PASSWORD=change_me_password

# Optional: Explicit path to PostgreSQL `bin/` directory if not on system PATH
# RFX_PG_BIN_DIR=

# Optional: Override default Case Study AOI source (.shp, .geojson, or .gpkg)
# RFX_AOI_SOURCE=data/case_study_aoi/rfx_aoi_boundary.shp
